;;

(def ex (href text) (a (:href (href) :target "_blank") (text)))
(def no-print (content) (block (:class "no-print") (content)))
(def term (title text) (span (:title (title) :style "text-decoration: underline;") (text)))

(def cn (text) (span (:lang "zh-Hans-CN") (text)))
(def hk (text) (span (:lang "zh-Hant-HK") (text)))
(def ja (text) (span (:lang "ja") (text)))

(def segment (title content)
  (block
    (header (:style "font-size: 1.5em; font-variant-caps: small-caps; border-bottom: 1px solid silver;") (title))
    (content) ))

(def exhibit (title subtitle text date url-text)
  (block (:style "margin: 1em 0")
    (block (title) --- (em (subtitle)))
    (block (:style "margin-top: 0.25em; padding-left: 2em") (text))
    (block (:style "text-align: right") (em (date)))
    (block (:style "text-align: right") (ex (:href "https://(url-text)") (em (url-text)))) ))

(html.head
  (html.include "import-katex.html")
  (html.include "last-modified.html")
  (link (:rel stylesheet :href "./main.css"))
  (link (:rel preconnect :href "https://fonts.googleapis.com"))
  (link (:rel preconnect :href "https://fonts.gstatic.com" :crossorigin))
  (link (:rel stylesheet :href "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"))
  (link (:rel stylesheet :href "https://fonts.googleapis.com/css2?family=Manufacturing+Consent&display=swap")) )
